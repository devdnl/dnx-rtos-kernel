#!/usr/bin/awk -f
#===============================================================================
# @file    mkirqtab.awk
#
# @author  Daniel Zorychta
#
# @brief   Generates list of interrupt handlers for drvset build from the kernel
#          vector table (src/cpu/<arch>/*_vectors.c).
#
# @note    Copyright (C) 2026 Daniel Zorychta <daniel.zorychta@gmail.com>
#
#          This program is free software; you can redistribute it and/or modify
#          it under the terms of the GNU General Public License as published by
#          the Free Software Foundation and modified by the dnx RTOS exception.
#
#          Full license text is available on the following file: doc/license.txt.
#
# Usage: awk -f mkirqtab.awk <kernel vectors.c> > drvset_irq.h
#
# Output: DRVSET_IRQ_LIST(X) macro, X(irq_number, handler_name) for each
# interrupt (vector table entry 16 + irq_number). Entries of the table are
# positional (one entry per line), the list ends at the first designated
# initializer ([index] = ...) or at the end of the table.
#===============================================================================

BEGIN {
        n = -1
        intable = 0
        count = 0
}

{
        sub(/\r$/, "")
}

intable && /^[ \t]*\[/ { intable = 0 }
intable && /^};/       { intable = 0 }

intable && match($0, /^[ \t]*[A-Za-z_(&][^,]*,/) {
        n++
        if (n >= 16) {
                name = $0
                sub(/^[ \t]*/, "", name)
                sub(/[ \t]*,.*$/, "", name)
                if (name !~ /^[A-Za-z_][A-Za-z0-9_]*$/) {
                        printf("mkirqtab: incorrect vector table entry %d: %s\n", n, $0) > "/dev/stderr"
                        exit 1
                }
                irq[count] = name
                count++
        }
}

/vectors\[256\].*=[ \t]*\{/ { intable = 1 }

END {
        if (count == 0) {
                print "mkirqtab: vector table not found" > "/dev/stderr"
                exit 1
        }
        print "/* Generated by mkirqtab.awk from the kernel vector table, do not edit. */"
        print "#define DRVSET_IRQ_COUNT " count
        print "#define DRVSET_IRQ_LIST(X) \\"
        for (i = 0; i < count; i++) {
                printf("        X(%d, %s) \\\n", i, irq[i])
        }
        print ""
}
