#!/usr/bin/env bash

if ! command -v dialog >/dev/null 2>&1; then
    echo "The 'dialog' command is not available."
    exit 1
fi

if ! command -v lua >/dev/null 2>&1; then
    echo "The Lua interpreter is not installed."
    exit 1
fi

ver=$(lua -v 2>&1 | grep -oE '[0-9]+\.[0-9]+')

major=${ver%%.*}
minor=${ver##*.}

if (( major > 5 || (major == 5 && minor >= 4) )); then

    if ! lua -l lfs -e "os.exit(0)" 2>/dev/null; then
        echo "The LFS package is not installed."
        exit 1
    fi

    SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    export CONFIGTOOL_DIR="$SCRIPT_DIR"

    lua "${SCRIPT_DIR}/configtool-cli.lua" "$@"
else
    echo "Lua must be version 5.4 or newer."
    exit 1
fi
